# Copy file nay thanh .env roi dien gia tri that.
# .env da bi .gitignore chan - KHONG BAO GIO commit no.

# --- Ung dung ---
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
IMAGE_DIR=./data/images
MAX_UPLOAD_BYTES=8388608
# Thoi han luu tru BAN QUET (anh goc + van ban OCR), tinh bang ngay.
# 0 = giu mai mai. Ho so da luu KHONG bi xoa theo - do la thu nguoi dung co y
# giu lai; muon xoa ca ho so thi goi DELETE /api/contacts/{id}.
# Don chay trong nen sau moi lan quet, cham nhat mot lan moi gio.
RETENTION_DAYS=0
# Streamlit goi backend tu phia may chu nen CORS khong con lien quan. Giu
# lai cho truong hop go loi bang trinh duyet hoac /docs.
CORS_ORIGINS=http://localhost:8501

# --- Xac thuc API ---
# DE TRONG = API mo, bat ky ai goi duoc cung doc duoc toan bo ho so. Chi nen
# de vay khi chi chay tren may ca nhan.
#
# Sinh khoa:
#   python -c "import secrets; print('ocr_' + secrets.token_urlsafe(32))"
#
# Nhieu khoa thi ngan cach bang dau phay - de cap rieng cho tung he thong
# tich hop, va thu hoi mot cai ma khong anh huong cac cai con lai.
API_KEYS=
RATE_LIMIT_PER_MINUTE=60

# --- OCR (Ngay 2) ---
# Chon MOT:
#   google    = Google Cloud Vision. Chat luong tot nhat, nhung BAT BUOC bat
#               billing (gan the) du 40 anh nam gon trong han muc mien phi.
#   tesseract = OCR chay ngay tren may. Mien phi, khong can the, khong can
#               mang. Doc Kanji kem hon Vision - so do chat luong se xau hon,
#               nhung van la so that. Phai cai Tesseract rieng, xem README.
#   rapidocr  = PP-OCR chay bang ONNX Runtime, cai bang `pip install
#               rapidocr onnxruntime`. Mien phi, khong can the. Model tai
#               ve o lan chay dau va MOI NGON NGU MOT MODEL - phai dat
#               OCR_LANGUAGE_HINTS khop voi the, xem README.
#   mock      = doc lai fixture da luu. Khong goi dich vu nao.
OCR_PROVIDER=mock
# Chi dien khi Tesseract khong nam trong PATH (hay gap tren Windows), vi du:
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR	esseract.exe
TESSERACT_CMD=
# Hai cach xac thuc Google Cloud - chon MOT:
#   (a) Tro toi file JSON service account (duong dan tuong doi tinh tu
#       backend/). Dung cach nay khi trien khai.
#   (b) DE TRONG dong duoi, roi chay:
#         gcloud auth application-default login
#       Tien hon khi phat trien tren may ca nhan.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa.json
OCR_TIMEOUT_S=20
# De goc neu bon ngon ngu: Anh, Han, Nhat, Trung.
# Them goi y ngon ngu gan nhu khong ton them chi phi; cai ton cong la bo
# sung mau thu va nhan chuan cho tung ngon ngu.
OCR_LANGUAGE_HINTS=ja,en,ko,zh

# --- Trich xuat truong (Ngay 4) ---
# gemini = model vision co schema | heuristic = regex, khong can mang
EXTRACTOR=heuristic
# Lay tai https://aistudio.google.com/apikey - khoa moi co dang "AQ.Ab8...",
# khoa cu co dang "AIzaSy...". Ca hai deu dung duoc.
GEMINI_API_KEY=
# Ten model thay doi theo thoi gian va theo tung tai khoan. KHONG doan.
# Chay lenh sau de xem tai khoan cua ban dang dung duoc model nao:
#   python backend/scripts/try_ocr.py --list-models
GEMINI_MODEL=
GEMINI_TEMPERATURE=0
EXTRACT_TIMEOUT_S=30

# --- Tra cuu doanh nghiep (Ngay 6) ---
ENRICH_ENABLED=true
ENRICH_MAX_PAGES=5
ENRICH_TIMEOUT_S=8
ENRICH_MAX_BYTES=2097152
ENRICH_USER_AGENT=BusinessCardBot/0.1

# --- Agent orchestration (12/09 plan); opt in, legacy behavior otherwise ---
AGENT_ENABLED=false
# Optional automatic research after OCR; still requires ENRICH_ENABLED=true.
AGENT_AUTO_ENRICH=false

# --- Webhook (moc 17/09) ---
# Bao cho he thong ben ngoai khi mot ban quet xu ly xong.
# MAC DINH TAT: day la tinh nang duy nhat gui du lieu RA NGOAI toi URL do
# nguoi dung nhap, ma API hien chua co xac thuc. Chi bat khi da them xac thuc
# hoac khi chac chan chi chay trong mang noi bo.
WEBHOOK_ENABLED=false
WEBHOOK_TIMEOUT_S=8
WEBHOOK_MAX_ATTEMPTS=3
