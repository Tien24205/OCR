# --- Bí mật: KHÔNG BAO GIỜ commit ---
.env
.env.*
!.env.example
secrets/
*.json.key
gcp-sa.json
.streamlit/secrets.toml

# --- Dữ liệu chạy (ảnh danh thiếp, database) ---
backend/data/
*.db
*.db-wal
*.db-shm

# --- Ảnh mẫu: chứa thông tin cá nhân thật, chỉ chia sẻ khi được phép ---
datasets/dev/
datasets/eval/

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.egg-info/

# --- Hệ điều hành / IDE ---
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# --- File tạm khi render PDF ---
tmp/

# --- Sinh ra tu cong cu, khong commit ---
# .gitignore KHONG ho tro chu thich cung dong: dau # se thanh mot phan cua
# pattern va lam quy tac mat tac dung. Chu thich phai o dong rieng.

# anh cat tu trang A4 de chay kho, khong phai anh chup
datasets/_dryrun/
# trang A4 de in, sinh lai bang make_card_sheets.py
datasets/print/
# Anh cat ra tu cac trang tren - sinh lai duoc bang
# `python backend/scripts/cut_cards.py`, nen khong commit.
datasets/the-cat/
# ban sao luu nhan cu do make_card_sheets.py tao
*.jsonl.bak
# dau ra tho cua evaluate.py; ban bao cao chinh thuc nam o
# Document/3-bao-cao/chat-luong.md
reports/

# Graphify knowledge graph (regenerate: /graphify . --update)
graphify-out/

# ==========================================================================
# TAI LIEU .md KHONG LEN GITHUB
# ==========================================================================
#
# Giu DUNG MOT tep: README.md o goc. Ai mo repo can biet day la gi va chay
# the nao; mot kho ma nguon khong co README la mot kho khong ai doc duoc.
#
# Con lai o trong may: ke hoach, bao cao theo ngay, tai lieu van dap. Chung
# van la bang chung qua trinh khi can trinh bay truc tiep, chi la khong cong
# khai.
#
# `/README.md` CO DAU GACH DAU, co y: khong co no thi `!README.md` se mien
# tru CA `Document/README.md` va `datasets/README.md` - gitignore khop ten
# tep o moi cap thu muc. Dau gach neo vao goc kho ma nguon.
*.md
!/README.md
