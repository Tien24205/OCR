# Thu gi lot vao day se nam trong image va di theo image di khap noi.
#
# HAI MUC DAU LA QUAN TRONG NHAT:
#   .venv     - vai tram MB, va la venv cua Windows nen trong Linux vo dung
#   **/.env   - CHUA KHOA THAT. Image thuong duoc day len registry, va mot
#               khoa nam trong lop image thi xoa tep di cung khong go duoc,
#               y het nhu commit khoa vao Git.
.venv/
venv/
**/.env

# --- Bi mat KHONG phai la .env -------------------------------------------
#
# VI SAO DANH SACH NAY TON TAI: `.env` khong phai cho duy nhat chua khoa.
# `backend/.env` khai
#
#     GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-sa.json
#
# tuc khoa service account cua Google nam o `backend/secrets/`. `.gitignore`
# da chan thu muc do tu lau, nhung tep nay thi CHUA - nen `COPY backend/
# backend/` trong Dockerfile nuot gon no vao image.
#
# Da kiem chung: dat mot tep gia o dung duong dan tren, build, roi `cat` ra
# tu trong container - noi dung hien nguyen. Sau khi them cac dong duoi day
# thi khong con.
#
# Danh sach nay la ban sao muc "Bi mat" cua `.gitignore`. Hai tep phai tra
# loi CUNG mot cau hoi - "thu gi khong duoc roi khoi may nay" - nen khi them
# mot loai khoa moi thi phai sua ca hai.
secrets/
**/secrets/
gcp-sa.json
**/gcp-sa.json
*.json.key
.streamlit/secrets.toml

# Du lieu chay - phai nam o volume, khong nam trong image. Nhoi vao day se
# lam moi ban dung deu bat dau voi CSDL cu cua may nguoi build.
backend/data/
reports/
datasets/
!datasets/labels.jsonl

# Rac
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.git/
.gitignore
node_modules/

# Khong can de chay
Document/
*.md
!README.md
